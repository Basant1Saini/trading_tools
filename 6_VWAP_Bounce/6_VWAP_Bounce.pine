//@version=5
strategy("VWAP Bounce & Cross", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ─── Inputs ───
showBands       = input.bool(true, "Show VWAP Bands", group="VWAP Settings")
bandMult1       = input.float(1.0, "Band 1 StdDev", step=0.1, group="VWAP Settings")
bandMult2       = input.float(2.0, "Band 2 StdDev", step=0.1, group="VWAP Settings")
entryMode       = input.string("Bounce", "Entry Mode", options=["Bounce", "Cross", "Both"], group="Entry")
bounceBuffer    = input.float(0.1, "Bounce Buffer (%)", step=0.05, group="Entry")
emaFilter       = input.int(20, "Trend Filter EMA", group="Filters")
useTrendFilter  = input.bool(true, "Use EMA Trend Filter", group="Filters")
atrLength       = input.int(14, "ATR Length", group="Risk Management")
atrMult         = input.float(1.5, "ATR Multiplier for SL", step=0.1, group="Risk Management")
rrRatio         = input.float(2.0, "Risk:Reward Ratio", step=0.1, group="Risk Management")
sessionFilter   = input.session("0930-1600", "Trading Session", group="Session")

// ─── VWAP Calculation ───
vwapVal         = ta.vwap(hlc3)
vwapDev         = ta.stdev(close - vwapVal, 20)
upperBand1      = vwapVal + vwapDev * bandMult1
lowerBand1      = vwapVal - vwapDev * bandMult1
upperBand2      = vwapVal + vwapDev * bandMult2
lowerBand2      = vwapVal - vwapDev * bandMult2

// ─── Trend Filter ───
emaVal          = ta.ema(close, emaFilter)
trendBull       = useTrendFilter ? close > emaVal : true
trendBear       = useTrendFilter ? close < emaVal : true

// ─── Session Filter ───
inSession       = not na(time(timeframe.period, sessionFilter))

// ─── ATR ───
atrVal          = ta.atr(atrLength)

// ─── Bounce Logic ───
bufferPct       = bounceBuffer / 100
nearVwapLong    = low <= vwapVal * (1 + bufferPct) and close > vwapVal
nearVwapShort   = high >= vwapVal * (1 - bufferPct) and close < vwapVal

// ─── Cross Logic ───
crossLong       = ta.crossover(close, vwapVal)
crossShort      = ta.crossunder(close, vwapVal)

// ─── Combined Entry ───
bounceLong      = (entryMode == "Bounce" or entryMode == "Both") and nearVwapLong
bounceShort     = (entryMode == "Bounce" or entryMode == "Both") and nearVwapShort
xLong           = (entryMode == "Cross" or entryMode == "Both") and crossLong
xShort          = (entryMode == "Cross" or entryMode == "Both") and crossShort

longCondition   = (bounceLong or xLong) and trendBull and inSession
shortCondition  = (bounceShort or xShort) and trendBear and inSession

// ─── Execute Trades ───
if longCondition and strategy.position_size == 0
    sl = close - atrVal * atrMult
    tp = close + (close - sl) * rrRatio
    strategy.entry("VWAP Long", strategy.long)
    strategy.exit("VWAP Long Exit", "VWAP Long", stop=sl, limit=tp)

if shortCondition and strategy.position_size == 0
    sl = close + atrVal * atrMult
    tp = close - (sl - close) * rrRatio
    strategy.entry("VWAP Short", strategy.short)
    strategy.exit("VWAP Short Exit", "VWAP Short", stop=sl, limit=tp)

// ─── Close at Session End ───
if not inSession and strategy.position_size != 0
    strategy.close_all("Session End")

// ─── Plotting ───
plot(vwapVal, "VWAP", color=color.new(color.yellow, 0), linewidth=3)
p1u = plot(showBands ? upperBand1 : na, "Upper Band 1", color=color.new(color.gray, 50))
p1l = plot(showBands ? lowerBand1 : na, "Lower Band 1", color=color.new(color.gray, 50))
p2u = plot(showBands ? upperBand2 : na, "Upper Band 2", color=color.new(color.gray, 70))
p2l = plot(showBands ? lowerBand2 : na, "Lower Band 2", color=color.new(color.gray, 70))
fill(p1u, p1l, color=color.new(color.yellow, 90), title="Band 1 Fill")
fill(p2u, p2l, color=color.new(color.yellow, 95), title="Band 2 Fill")

plotshape(longCondition, title="Long", location=location.belowbar, style=shape.circle, color=color.green, size=size.tiny)
plotshape(shortCondition, title="Short", location=location.abovebar, style=shape.circle, color=color.red, size=size.tiny)

// ─── Alerts ───
alertcondition(longCondition, title="VWAP Long", message="VWAP: Long entry signal")
alertcondition(shortCondition, title="VWAP Short", message="VWAP: Short entry signal")
