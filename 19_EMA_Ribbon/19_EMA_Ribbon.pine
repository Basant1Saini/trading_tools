//@version=5
strategy("EMA Ribbon", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// === INPUTS ===
ema1Len = input.int(8, "EMA 1 (Fastest)", minval=3)
ema2Len = input.int(13, "EMA 2", minval=5)
ema3Len = input.int(21, "EMA 3", minval=8)
ema4Len = input.int(34, "EMA 4", minval=13)
ema5Len = input.int(55, "EMA 5", minval=21)
ema6Len = input.int(89, "EMA 6 (Slowest)", minval=34)
ribbonMode  = input.string("Full Stack", "Entry Mode", options=["Full Stack", "Partial (4 of 6)", "Fast Cross Slow"])
atrLen      = input.int(14, "ATR Length")
atrMult     = input.float(2.0, "ATR Multiplier (SL)", step=0.1)
trailATR    = input.float(3.0, "Trailing ATR Multiplier", step=0.1)

// === EMAs ===
e1 = ta.ema(close, ema1Len)
e2 = ta.ema(close, ema2Len)
e3 = ta.ema(close, ema3Len)
e4 = ta.ema(close, ema4Len)
e5 = ta.ema(close, ema5Len)
e6 = ta.ema(close, ema6Len)
atr = ta.atr(atrLen)

// === RIBBON ANALYSIS ===
// Full bull stack: e1 > e2 > e3 > e4 > e5 > e6
fullBull = e1 > e2 and e2 > e3 and e3 > e4 and e4 > e5 and e5 > e6
fullBear = e1 < e2 and e2 < e3 and e3 < e4 and e4 < e5 and e5 < e6

// Partial: at least 4 of 5 pairs in order
bullPairs = (e1 > e2 ? 1 : 0) + (e2 > e3 ? 1 : 0) + (e3 > e4 ? 1 : 0) + (e4 > e5 ? 1 : 0) + (e5 > e6 ? 1 : 0)
bearPairs = (e1 < e2 ? 1 : 0) + (e2 < e3 ? 1 : 0) + (e3 < e4 ? 1 : 0) + (e4 < e5 ? 1 : 0) + (e5 < e6 ? 1 : 0)
partialBull = bullPairs >= 4
partialBear = bearPairs >= 4

// Fast cross slow
fastCrossBull = ta.crossover(e1, e6)
fastCrossBear = ta.crossunder(e1, e6)

// === MODE SELECTION ===
var bool longCond = false
var bool shortCond = false

if ribbonMode == "Full Stack"
    longCond  := fullBull and not fullBull[1]
    shortCond := fullBear and not fullBear[1]
else if ribbonMode == "Partial (4 of 6)"
    longCond  := partialBull and not partialBull[1]
    shortCond := partialBear and not partialBear[1]
else
    longCond  := fastCrossBull
    shortCond := fastCrossBear

// === ENTRIES ===
if longCond and strategy.position_size <= 0
    sl = close - atr * atrMult
    strategy.entry("RibbonL", strategy.long)
    strategy.exit("RibbonLX", "RibbonL", stop=sl, trail_offset=atr * trailATR, trail_points=atr * trailATR)

if shortCond and strategy.position_size >= 0
    sl = close + atr * atrMult
    strategy.entry("RibbonS", strategy.short)
    strategy.exit("RibbonSX", "RibbonS", stop=sl, trail_offset=atr * trailATR, trail_points=atr * trailATR)

// === PLOTS ===
p1 = plot(e1, "EMA 8", color.new(color.lime, 0), 1)
p2 = plot(e2, "EMA 13", color.new(color.green, 10), 1)
p3 = plot(e3, "EMA 21", color.new(color.teal, 20), 1)
p4 = plot(e4, "EMA 34", color.new(color.blue, 30), 1)
p5 = plot(e5, "EMA 55", color.new(color.purple, 40), 1)
p6 = plot(e6, "EMA 89", color.new(color.red, 50), 1)
fill(p1, p6, fullBull ? color.new(color.green, 85) : fullBear ? color.new(color.red, 85) : color.new(color.gray, 95))
plotshape(longCond, "Ribbon Bull", shape.triangleup, location.belowbar, color.green, text="RBN↑")
plotshape(shortCond, "Ribbon Bear", shape.triangledown, location.abovebar, color.red, text="RBN↓")
