//@version=5
strategy("NR7 Range Breakout", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// === INPUTS ===
nrPeriod    = input.int(7, "NR Lookback Period", minval=4, maxval=14, tooltip="NR7 = narrowest range of last 7 bars")
emaLen      = input.int(50, "Trend EMA Length", minval=10)
useTrend    = input.bool(true, "Use Trend Filter")
volFilter   = input.bool(true, "Volume Confirmation on Breakout")
volMult     = input.float(1.3, "Volume Multiplier", step=0.1)
buffer      = input.float(0.1, "Breakout Buffer %", step=0.05)
atrLen      = input.int(14, "ATR Length")
atrMult     = input.float(1.5, "ATR Multiplier (SL)", step=0.1)
rrRatio     = input.float(2.5, "Risk:Reward", step=0.1)

// === CALCULATIONS ===
barRange = high - low

// Check if current bar has the narrowest range in the last N bars
isNR = true
for i = 1 to nrPeriod - 1
    if barRange >= (high[i] - low[i])
        isNR := false
        break

ema     = ta.ema(close, emaLen)
atr     = ta.atr(atrLen)
avgVol  = ta.sma(volume, 20)
highVol = not volFilter or volume >= avgVol * volMult

trendUp = not useTrend or close > ema
trendDn = not useTrend or close < ema

// === SIGNALS ===
var bool pendingLong  = false
var bool pendingShort = false
var float nrHigh = na
var float nrLow  = na

if isNR
    nrHigh := high + high * buffer / 100
    nrLow  := low - low * buffer / 100
    pendingLong  := true
    pendingShort := true

longBreak  = pendingLong and close > nrHigh and highVol and trendUp
shortBreak = pendingShort and close < nrLow and highVol and trendDn

if longBreak
    pendingLong := false
if shortBreak
    pendingShort := false

// Reset after 3 bars
if ta.barssince(isNR) > 3
    pendingLong  := false
    pendingShort := false

// === ENTRIES ===
if longBreak and strategy.position_size == 0
    sl = close - atr * atrMult
    tp = close + (close - sl) * rrRatio
    strategy.entry("NR7L", strategy.long)
    strategy.exit("NR7LX", "NR7L", stop=sl, limit=tp)

if shortBreak and strategy.position_size == 0
    sl = close + atr * atrMult
    tp = close - (sl - close) * rrRatio
    strategy.entry("NR7S", strategy.short)
    strategy.exit("NR7SX", "NR7S", stop=sl, limit=tp)

// === PLOTS ===
plot(ema, "Trend EMA", color.orange, 2)
bgcolor(isNR ? color.new(color.purple, 85) : na)
plotshape(isNR, "NR7 Bar", shape.diamond, location.abovebar, color.new(color.purple, 0), text="NR7")
plotshape(longBreak, "NR7 Long", shape.labelup, location.belowbar, color.green, text="NR7↑", textcolor=color.white)
plotshape(shortBreak, "NR7 Short", shape.labeldown, location.abovebar, color.red, text="NR7↓", textcolor=color.white)
